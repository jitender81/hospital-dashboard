# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file (it's already in .gitignore).

# development | production
# In production, the app refuses to start unless JWT_SECRET_KEY is set below.
ENVIRONMENT=development

# MongoDB connection. For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=hospital_db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production — the app will not start without it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins.
# In production, use your real domain only — never localhost, never "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Leave false everywhere except a throwaway staging DB you're okay wiping.
ALLOW_SEED_ENDPOINT=false